#!/usr/bin/env ruby
# frozen_string_literal: true

# Put this checkout's lib/ on the load path so in-tree plugins are
# discoverable by Documark::Plugins.discover! the same way an installed
# plugin gem would be.
$LOAD_PATH.unshift(File.expand_path('../lib', __dir__))

require 'slop'
require 'kramdown'
require 'tmpdir'
require 'fileutils'
require_relative '../lib/documark/runtime'
require_relative '../lib/documark/parser'
require_relative '../lib/documark/config'
require_relative '../lib/documark/export_clean'
require_relative '../lib/documark/render_html'
require_relative '../lib/documark/render_pdf'
require_relative '../lib/documark/plugins'
require_relative '../lib/documark/container'

extend Documark::Runtime
extend Documark::Parser
extend Documark::Config
extend Documark::ExportClean
extend Documark::RenderHtml
extend Documark::RenderPdf

Documark::Targets.register('html',     feature: 'html')     { |ctx| write_page(ctx['output'], ctx['page']) }
Documark::Targets.register('pdf',      feature: 'pdf')      { |ctx| render_pdf(ctx['page'], ctx['output'], ctx['layout'], ctx['base_url']) }
Documark::Targets.register('markdown', feature: 'markdown') { |ctx| write_markdown_output(ctx['output'], ctx['doc']['body'], ctx['data']) }
Documark::Targets.register('text',     feature: 'text')     { |ctx| write_markdown_output(ctx['output'], ctx['doc']['body'], ctx['data']) }
Documark::Targets.register('epub',     feature: 'epub')     { |_ctx| raise NotImplementedError, "Target 'epub' is not yet implemented." }

DEFAULT_RUNTIME_CONFIG = {
  'default_layout' => File.expand_path('../lib/documark/default.dml', __dir__)
}.freeze

def parse_defines(list)
  Array(list).each_with_object({}) do |item, acc|
    key, sep, value = item.to_s.partition('=')
    acc[key] = sep.empty? ? true : value
  end
end

def merge_config(file_config, options)
  merged = DEFAULT_RUNTIME_CONFIG.dup

  [file_config, options].each do |source|
    source.each do |key, value|
      next if value.nil?
      next if value.respond_to?(:empty?) && value.empty?
      next if source.equal?(options) && %w[verbose debug].include?(key) && value == false

      merged[key] = value
    end
  end

  merged
end

def require_options!(config, keys, action_name)
  keys.each do |required_key|
    if config[required_key].nil? || config[required_key].to_s.strip.empty?
      warn "Missing required option for #{action_name} action: --#{required_key}"
      exit 1
    end
  end
end

def process_action(config)
  require_options!(config, %w[input output target], 'process')

  ordie { Documark::Plugins.require_features!([config['target']], source: '--target') }

  document = read_document(config['input'])
  header = document['header']
  doc = document['doc']
  data = document['data']
  data = data.merge(parse_defines(Array(config['define'])))
  layout = read_layout(doc, config)

  required = Array(data['requires']) | Array(layout['requires'])
  ordie { Documark::Plugins.require_features!(required, source: config['input']) }

  layout['container_class'] = '' if %w[pdf epub].include?(config['target'])

  if config["verbose"]
    puts "--- Header ---"
    pp header
    puts "--- Front Matter (#{doc["body"].bytesize} body bytes) ---"
    pp data
    puts "--- Config ---"
    pp config
    puts "--- Features ---"
    Documark::Plugins.features.each do |name, meta|
      parts = []
      if (exts = Documark::Include.exts_for(name))
        parts << "include-type '#{name}'#{exts.empty? ? '' : " (#{exts.join(', ')})"}"
      end
      if Documark::Directives.lookup(name)
        kind = Documark::Directives.kind_for(name)
        parts << "directive '#{name}' (#{kind})"
      end
      parts << "target '#{name}'" if Documark::Targets.lookup(name)
      origin = meta[:plugin] || 'unknown'
      puts "  '#{name}' [#{origin}]#{parts.empty? ? '' : " — #{parts.join(', ')}"}"
    end
  end

  target       = config['target']
  tmp_asset_dir = extract_container_assets!(config, doc, target)

  begin
    handler = Documark::Targets.lookup(target)
    base_url = config['asset_base'] || File.dirname(File.expand_path(config['input']))
    page    = render_page(config, layout, data, doc['body']) if %w[html pdf epub].include?(target)
    ctx     = { 'output' => config['output'], 'page' => page, 'layout' => layout,
                'doc' => doc, 'data' => data, 'base_url' => base_url }
    puts "write to #{config['output']}" if config['verbose']
    ordie { handler.call(ctx) }
  ensure
    FileUtils.remove_entry(tmp_asset_dir) if tmp_asset_dir && File.directory?(tmp_asset_dir)
  end
end

# When the document carries a trailing `!! assets` container section, decode
# it so includes, images, and stylesheets resolve during rendering. Sets
# config['asset_base'] to the extraction directory and returns the temp dir
# that must be cleaned up (pdf/epub), or nil when no cleanup is required
# (html extracts beside the output; markdown/text do not extract at all).
def extract_container_assets!(config, doc, target)
  return nil if doc['assets'].nil?

  case target
  when 'pdf', 'epub'
    tmp = Dir.mktmpdir('documark-assets-')
    ordie { Documark::Container.decode_assets(doc['assets'], tmp) }
    config['asset_base'] = tmp
    tmp
  when 'html'
    dest = File.dirname(File.expand_path(config['output']))
    ordie { Documark::Container.decode_assets(doc['assets'], dest) }
    config['asset_base'] = dest
    nil
  end
end

def pack_action(config)
  require_options!(config, %w[input output], 'pack')

  ordie { Documark::Container.pack_file(config['input'], config['output']) }
end

def unpack_action(config)
  require_options!(config, %w[input output], 'unpack')

  ordie { Documark::Container.unpack_file(config['input'], config['output']) }
end

valid_actions = %w[process pack unpack config_new template_new]
valid_targets = Documark::Targets.registered
action_index = ARGV.index { |token| valid_actions.include?(token) }

if action_index.nil?
  unless ARGV.include?('-h') || ARGV.include?('--help')
    warn "Missing action. Supported actions: #{valid_actions.join(', ')}"
    warn "Run 'documark --help' for usage."
    exit 1
  end
  cli_argv = ARGV.dup
else
  action = ARGV[action_index]
  cli_argv = ARGV.dup
  cli_argv.delete_at(action_index)
end

begin
  opts = Slop.parse(cli_argv) do |o|
    o.banner = <<~BANNER
      Documark — document processor

      Usage:
        documark <action> [options]

      Actions:
        process       Convert a document to an output format
        pack          Bundle a document and its local assets into a single container file
        unpack        Extract a container's document and assets into a directory
        config_new    Generate a new config file in the current directory
        template_new  Generate a new document template

      Example:
        documark process -i mydoc.dm -o output.html -t html
        documark pack -i mydoc.dm -o mydoc.dmc
        documark unpack -i mydoc.dmc -o mydoc-unpacked/

      Supported targets: #{valid_targets.join(', ')}

      Options:
    BANNER
    o.string  '-i', '--input',   'Input .dm file (or .dmc container for unpack)'
    o.string  '-o', '--output',  'Output file path (or destination directory for unpack)'
    o.string  '-t', '--target',  "Output format (#{valid_targets.join(', ')})"
    o.bool    '-v', '--verbose', 'Verbose output'
    o.string  '-c', '--config',  'Config file path'
    o.bool    '-d', '--debug',   'Show full stack traces on errors'
    o.array   '--define', 'Set data key (key=value or bare key), repeatable; overrides document data'
    o.on      '-h', '--help',    'Show this message' do
      puts o
      exit
    end
  end
rescue Slop::MissingRequiredOption => e
  warn e.message
  exit 1
end

options = opts.to_h.transform_keys(&:to_s)
options['target'] = options['target'].to_s.downcase

Documark::Runtime.debug = options['debug']

ordie { Documark::Plugins.discover!(verbose: options['verbose']) }

file_config = read_config(options['config'])
config = merge_config(file_config, options)

case action
when 'config_new'
  Documark::Config.config_new
when 'template_new'
  Documark::Config.template_new(file_config, options)
when 'process'
  process_action(config)
when 'pack'
  pack_action(config)
when 'unpack'
  unpack_action(config)
else
  warn "Unsupported action '#{action}'. Supported actions: #{valid_actions.join(', ')}"
  warn "Run 'documark --help' for usage."
  exit 1
end
